# ============================================
# INTECOAL SAS - Portal de Radicacion RETILAP
# Variables de Entorno
# ============================================

# Frontend (Vite): login Microsoft (MSAL). tenant "common" acepta cuentas
# corporativas y personales de Microsoft.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=common
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# Backend (FastAPI) - para Render.com
AZURE_CLIENT_ID=          # App de Entra ID (Graph: Mail.Send + SharePoint)
AZURE_TENANT_ID=          # Tenant EMC (GUID, distinto al VITE de arriba)
AZURE_CLIENT_SECRET=      # Secreto de la app (rotar cada 6-12 meses)
SHAREPOINT_SITE_ID=       # Sitio de SharePoint (GUID o hostname)
SHAREPOINT_LIST_ID=       # Lista Radicaciones_AP (GUID)
SHAREPOINT_LIBRARY_ID=Documents   # LibrerÃ­a de documentos (se resuelve por nombre)
SECRET_KEY=CHANGE_ME_random_string_at_least_32_chars  # Firma JWT (32+ caracteres)
M365_SENDER_EMAIL=coord.tecnico@intecoalsas.com  # Remitente general (respaldo)
M365_NOTIFICATION_RECIPIENT=coord.tecnico@intecoalsas.com  # Revisor: avisos de nuevo radicado y vencimientos
FRONTEND_URL=https://tu-sitio.netlify.app  # Origen permitido CORS (producciÃ³n)
ALLOWED_ORIGINS=          # Extra CORS separados por coma (opcional; "*" = abierto)
POWER_AUTOMATE_WEBHOOK_URL=   # Opcional: webhook de Power Automate
